{
  "name": "steamguard-web",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply steamguard-web --local",
    "db:migrate:remote": "wrangler d1 migrations apply steamguard-web --remote",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy --minify && bun run bootstrap-admin -- --remote",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "proto:generate": "bun run scripts/generate-protobuf.ts",
    "bootstrap-admin": "bun run scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-validator": "^0.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.21",
    "lucide-react": "^1.16.0",
    "node-forge": "^1.4.0",
    "protobufjs": "^8.4.2",
    "radix-ui": "^1.4.3",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "protobufjs-cli": "^2.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.4.0"
  }
}
