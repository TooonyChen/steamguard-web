{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steamguard-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  // Daily retention cleanup (sessions, auth flows, login throttle counters, audit events).
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steamguard-web",
      "database_id": "7ed1b2cd-487b-4cb4-bdb1-b54608680bc8"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
