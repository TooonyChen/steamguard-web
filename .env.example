# Required Worker secrets for production.
# Both are also needed locally — copy this file to .dev.vars and fill the values.

# High-entropy random secret. Used to wrap per-account encryption keys.
# BACK THIS UP — rotating it invalidates every account grant.
# Suggested: openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-production-secret

# Initial admin password. The bootstrap script reads this once when the
# users table is empty, hashes it into D1, then never reads it again.
# The admin will be forced to change it on first login.
# Suggested: openssl rand -hex 32
INITIAL_ADMIN_PASSWORD=replace-before-bootstrap-and-change-after-first-login
