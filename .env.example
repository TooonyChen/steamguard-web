# Required Worker secrets.
# Use a high-entropy value and keep it backed up; it wraps account key grants.
# # recommended to use `openssl rand -hex 32` to generate a random secret
APP_SECRET=replace-with-a-long-random-production-secret

# Required when bootstrapping production/remote.
# The bootstrap script creates admin with must_change_password=true and never prints this value.
# recommended to use `openssl rand -hex 32` to generate a random password
INITIAL_ADMIN_PASSWORD=replace-before-bootstrap-and-change-after-first-login

# Worker environment marker.
ENVIRONMENT=production 

# Optional script override. Defaults to the D1 database name in wrangler.jsonc.
D1_DATABASE_NAME=steamguard-web
